---
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import ContactLinks from "@components/ContactLinks.astro"
---
<PageLayout title="联系" description="邮箱及社交平台联系方式，待补充。">
  <TopLayout>
    <div class="animate">
      <p class="text-xs tracking-widest opacity-60">LET'S CONNECT</p>
      <h1 class="text-3xl font-semibold text-black dark:text-white mt-2">联系</h1>
      <p class="mt-3">关于内容、影像与创作，期待更多交流。</p>
    </div>
  </TopLayout>
  <BottomLayout>
    <div class="animate">
      <p>联系方式尚未配置。以下为占位信息，补充真实邮箱或主页后即可使用。</p>
      <ContactLinks />
    </div>
  </BottomLayout>
</PageLayout>
