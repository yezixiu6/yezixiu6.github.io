---
import { getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import ArrowCard from "@components/ArrowCard"
import ContactLinks from "@components/ContactLinks.astro"
import { SITE, PROFILE } from "@consts"
import TwinklingStars from "@components/TwinklingStars.astro"
import MeteorShower from "@components/MeteorShower.astro"
const projects = (await getCollection("projects"))
  .filter(project => !project.data.draft && project.data.featured)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3)
---
<PageLayout title="首页" description={SITE.DESCRIPTION}>
  <!-- Light Mode: Particles -->
  <div class='absolute inset-0 block dark:hidden'>
    <div id='particles1' class='fixed inset-0'></div>
    <div id='particles2' class='fixed inset-0'></div>
    <div id='particles3' class='fixed inset-0'></div>
  </div>

  <!-- Dark Theme: Stars -->
  <div class='absolute inset-0 bg-black hidden dark:block'>
    <div id='stars1' class='fixed inset-0'></div>
    <div id='stars2' class='fixed inset-0'></div>
    <div id='stars3' class='fixed inset-0'></div>
  </div>

  <!-- Dark Theme: Twinkling Stars / Metors -->
  <div id="galaxy" class="fixed inset-0">
    <div class="hidden dark:block">
      <TwinklingStars/>
      <MeteorShower/>
    </div>
  </div>

  <script is:inline src="/js/bg.js"></script>
  
  <!-- HERO -->
  <section class="relative h-screen w-full">
    <div id="planetcont" class='animate absolute inset-0 top-1/4 overflow-hidden'>
      <div id="crescent" class='absolute top-0 left-1/2 -translate-x-1/2 w-[250vw] min-h-[100vh] aspect-square rounded-full p-[1px] bg-gradient-to-b from-black/25 dark:from-white/75 from-0% to-transparent to-5%'>
        <div id="planet" class='w-full h-full bg-white dark:bg-black rounded-full p-[1px] overflow-hidden flex justify-center'>
          <div id="blur" class='w-full h-20 rounded-full bg-neutral-900/25 dark:bg-white/25 blur-3xl'/>
        </div>
      </div>
    </div>
    <div class="animate absolute h-full w-full flex items-center justify-center">
      <div class='relative w-full h-full flex items-center justify-center'>
        <div class='p-5 text-center'>
          <p class='animated text-lg md:text-xl lg:text-2xl font-semibold opacity-75'>
            HELLO, I AM
          </p>
          <h1 class='animated text-2xl md:text-3xl lg:text-4xl font-bold uppercase text-black dark:text-white'>
            {PROFILE.NAME}
          </h1>
          <p class='animated text-sm md:text-base lg:text-lg opacity-75'>
            {PROFILE.INTRO}
          </p>
          <p class="animated text-xs mt-3 opacity-50">姓名占位 · 个人资料与真实作品待补充</p>
          <div id="ctaButtons" class='animated flex flex-wrap gap-4 justify-center mt-5'>
            <a href='/projects' class='py-2 px-4 rounded truncate text-xs md:text-sm lg:text-base bg-black dark:bg-white text-white dark:text-black hover:opacity-75 blend'>
              浏览作品
            </a>
            <a href='/work' class='py-2 px-4 truncate rounded text-xs md:text-sm lg:text-base border border-black/25 dark:border-white/25 hover:bg-black/5 hover:dark:bg-white/15 blend'>
              关于我
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="relative bg-white dark:bg-black">
    <div class="mx-auto max-w-screen-sm p-5 space-y-24 pb-16">
      <section class="animate">
        <p class="text-xs tracking-widest opacity-60 mb-5">A PERSONAL CREATIVE ARCHIVE</p>
        <article class="pb-0">
          <h2>让想法，成为作品。</h2>
          <p>{PROFILE.BIO}</p>
          <p>这个作品集围绕内容策划、数字媒体与 AI 创作展开，关注作品本身，也关注它背后的思考与过程。</p>
        </article>
        <a href="/work" class="inline-block mt-5 text-sm underline underline-offset-4 hover:text-black dark:hover:text-white blend">更多关于我 →</a>
      </section>
      <section class="animate">
        <div class="flex justify-between items-center gap-4 mb-5">
          <h2 class="font-semibold text-black dark:text-white">精选作品 <span class="font-normal text-xs opacity-60">/ SELECTED WORK</span></h2>
          <a href="/projects" class="shrink-0 text-sm underline underline-offset-4 hover:text-black dark:hover:text-white blend">全部作品 →</a>
        </div>
        <p class="text-sm opacity-60 mb-5">以下为展示结构的占位项目，封面为示意图，真实作品待替换。</p>
        <ul class="space-y-4">
          {projects.map(project => <li><ArrowCard entry={project} /></li>)}
        </ul>
      </section>
      <section class="animate">
        <h2 class="font-semibold text-black dark:text-white mb-5">创作方向 <span class="font-normal text-xs opacity-60">/ AREAS OF INTEREST</span></h2>
        <ul>
          {PROFILE.DIRECTIONS.map(item => (
            <li class="py-5 border-b border-black/10 dark:border-white/20 first:pt-0 last:border-0">
              <div class="flex flex-wrap justify-between items-baseline gap-2">
                <h3 class="font-semibold text-black dark:text-white">{item.name}</h3>
                <span class="text-xs tracking-wider opacity-50">{item.english}</span>
              </div>
              <p class="text-sm mt-2">{item.text}</p>
            </li>
          ))}
        </ul>
      </section>
      <section class="animate">
        <h2 class="font-semibold text-black dark:text-white">保持联系 <span class="font-normal text-xs opacity-60">/ LET'S CONNECT</span></h2>
        <p class="mt-3">邮箱及社交平台链接待补充。</p>
        <ContactLinks />
      </section>
    </div>
  </div>
</PageLayout>
