---
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import TopLayout from "@layouts/TopLayout.astro";
import BottomLayout from "@layouts/BottomLayout.astro";
import SearchCollection from "@components/SearchCollection";
import { PROJECTS } from "@consts";
import { compareProjects } from "@lib/projects";


const projects = (await getCollection("projects"))
  .filter((project) => !project.data.draft)
  .sort(compareProjects);

const tags = [
  ...new Set(projects.flatMap((project) => project.data.tags)),
].sort((a, b) => a.localeCompare(b));

const estimated_initial_size =
  28 + projects.length * 158 + (projects.length - 1) * 12;
---

<PageLayout title={PROJECTS.TITLE} description={PROJECTS.DESCRIPTION}>
  <TopLayout>
    <div class="animate">
      <h1 class="text-3xl font-semibold text-black dark:text-white mt-2">
        {PROJECTS.TITLE}
      </h1>
      <div class="mt-1">
        {PROJECTS.DESCRIPTION}
      </div>
      <p class="mt-3 text-sm opacity-60">已收录亚运人物图文、短视频策划、医疗健康 IP 运营与 AI 二创 PV。个人创作项目的真实内容待补充。</p>
    </div>
  </TopLayout>
  <BottomLayout>
    <div
      id="search-collection-wrapper"
      class="animate"
      style={{ minHeight: `${estimated_initial_size}px` }}
    >
      <SearchCollection
        client:load
        entry_name={"projects"}
        tags={tags}
        data={projects}
      />
    </div>
  </BottomLayout>
</PageLayout>
