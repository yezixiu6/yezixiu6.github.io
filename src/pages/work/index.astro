---
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import { WORK, PROFILE } from "@consts"
---
<PageLayout title={WORK.TITLE} description={WORK.DESCRIPTION}>
  <TopLayout>
    <div class="animate">
      <p class="text-xs tracking-widest opacity-60">ABOUT ME</p>
      <h1 class="text-3xl font-semibold text-black dark:text-white mt-2">关于我</h1>
      <p class="mt-3">{PROFILE.NAME}</p>
    </div>
  </TopLayout>
  <BottomLayout>
    <div class="space-y-12">
      <section class="animate">
        <h2 class="font-semibold text-black dark:text-white">个人简介</h2>
        <p class="mt-3 leading-relaxed">{PROFILE.BIO}</p>
      </section>
      <section class="animate border-t border-black/10 dark:border-white/20 pt-8">
        <h2 class="font-semibold text-black dark:text-white">专业背景</h2>
        <dl class="mt-4 grid grid-cols-[5rem_minmax(0,1fr)] gap-3">
          <dt>教育背景</dt><dd>{PROFILE.EDUCATION}</dd>
          <dt>求职方向</dt><dd class="leading-relaxed">{PROFILE.JOB_DIRECTIONS.join("、")}</dd>
        </dl>
      </section>
      <section class="animate border-t border-black/10 dark:border-white/20 pt-8">
        <h2 class="font-semibold text-black dark:text-white">核心技能</h2>
        <ul class="flex flex-wrap gap-2 mt-5">
          {PROFILE.SKILLS.map(skill => (
            <li class="text-sm py-1 px-3 rounded bg-black/5 dark:bg-white/10">{skill}</li>
          ))}
        </ul>
      </section>
      <section class="animate border-t border-black/10 dark:border-white/20 pt-8">
        <h2 class="font-semibold text-black dark:text-white">实习经历 <span class="font-normal text-xs opacity-60">/ EXPERIENCE</span></h2>
        <p class="text-sm mt-5 opacity-60">{PROFILE.INTERNSHIP.PERIOD}</p>
        <h3 class="font-semibold text-black dark:text-white mt-2">{PROFILE.INTERNSHIP.COMPANY}｜{PROFILE.INTERNSHIP.ROLE}</h3>
        <h4 class="text-sm font-semibold mt-6">工作内容</h4>
        <ul class="list-disc pl-5 space-y-3 mt-3 leading-relaxed">
          {PROFILE.INTERNSHIP.RESPONSIBILITIES.map(item => <li>{item}</li>)}
        </ul>
        <h4 class="text-sm font-semibold mt-6">项目成果</h4>
        <ul class="list-disc pl-5 space-y-3 mt-3 leading-relaxed">
          {PROFILE.INTERNSHIP.OUTCOMES.map(item => <li>{item}</li>)}
        </ul>
      </section>
      <section class="animate pb-8">
        <a href="/projects" class="underline underline-offset-4 hover:text-black dark:hover:text-white blend">浏览作品集 →</a>
      </section>
    </div>
  </BottomLayout>
</PageLayout>
